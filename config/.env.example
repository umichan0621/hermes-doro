# ── Model (GLM Coding Plan, OpenAI-compatible) ──
OPENAI_API_KEY=your-GLM-CP-key

# ── Lark (Feishu) ──
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=secret_xxx
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_ALLOWED_USERS=ou_xxx
FEISHU_GROUP_POLICY=allowlist
FEISHU_HOME_CHANNEL=oc_xxx

# ── QQ bot (official open platform q.qq.com) ──
# The gateway skips QQ while credentials are empty. After registering a bot,
# fill in credentials and set up the platforms.qq allowlist in data/config.yaml.
QQ_APP_ID=
QQ_CLIENT_SECRET=

# Must match ~/.config/opencode-serve/auth.env on the host.
OPENCODE_SERVER_PASSWORD=change-me
