# Runtime state and credentials are never tracked.
/data/

# Cron: only the README is tracked; jobs.yaml, apply.sh and scripts/ stay
# local (internal identifiers / private repo workflow).
/cron/*
!/cron/README.md

# Private skill repos are independent git clones, never tracked here.
# Only the directory README is committed.
/skills_private/*
!/skills_private/README.md

# Track only explicit templates; live configuration and backups stay local.
/config/*
!/config/.env.example
!/config/config.yaml.example
!/config/SOUL.md.example
!/config/opencode_projects.yaml.example

__pycache__/

# Local editor/system miscellanea
*.swp
*.swo
.DS_Store
