[Unit]
Description=OpenCode headless server for project %i
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/opencode-serve/auth.env
EnvironmentFile=%h/.config/opencode-serve/%i.env
ExecStart=/bin/bash -lc 'cd "$OPENCODE_PROJECT_DIR" && exec %h/.opencode/bin/opencode serve --hostname 172.17.0.1 --port "$OPENCODE_PROJECT_PORT"'
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
